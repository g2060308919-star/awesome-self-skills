{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-bundle.schema.json",
  "$defs": {
    "v4Text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "v4IdSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/v4Text"
      }
    },
    "v4StringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/v4Text"
      }
    },
    "v4CasePrecondition": {
      "type": "object",
      "required": [
        "precondition_id",
        "description"
      ],
      "properties": {
        "precondition_id": {
          "$ref": "#/$defs/v4Text"
        },
        "description": {
          "$ref": "#/$defs/v4Text"
        }
      },
      "additionalProperties": false
    },
    "v4CaseCondition": {
      "type": "object",
      "required": [
        "condition_id",
        "description"
      ],
      "properties": {
        "condition_id": {
          "$ref": "#/$defs/v4Text"
        },
        "description": {
          "$ref": "#/$defs/v4Text"
        }
      },
      "additionalProperties": false
    },
    "v4CaseStep": {
      "type": "object",
      "required": [
        "step_id",
        "action"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/v4Text"
        },
        "action": {
          "$ref": "#/$defs/v4Text"
        }
      },
      "additionalProperties": false
    },
    "v4CaseOracle": {
      "type": "object",
      "required": [
        "oracle_id",
        "observe_after_step_id",
        "surface",
        "expected",
        "claim_ids"
      ],
      "properties": {
        "oracle_id": {
          "$ref": "#/$defs/v4Text"
        },
        "observe_after_step_id": {
          "$ref": "#/$defs/v4Text"
        },
        "surface": {
          "enum": [
            "ui",
            "request",
            "response",
            "persistence",
            "event",
            "callback",
            "compensation",
            "side_effect",
            "external_observation"
          ]
        },
        "expected": {
          "$ref": "#/$defs/v4Text"
        },
        "claim_ids": {
          "$ref": "#/$defs/v4IdSet"
        }
      },
      "additionalProperties": false
    },
    "v4SemanticEffect": {
      "type": "object",
      "required": [
        "effect_id",
        "kind",
        "subject",
        "after",
        "claim_ids"
      ],
      "properties": {
        "effect_id": {
          "$ref": "#/$defs/v4Text"
        },
        "kind": {
          "$ref": "#/$defs/v4Text"
        },
        "subject": {
          "$ref": "#/$defs/v4Text"
        },
        "before": {
          "$ref": "#/$defs/v4Text"
        },
        "after": {
          "$ref": "#/$defs/v4Text"
        },
        "claim_ids": {
          "$ref": "#/$defs/v4IdSet"
        }
      },
      "additionalProperties": false
    },
    "v4TestValueOrigin": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "claim_ids"
          ],
          "properties": {
            "kind": {
              "const": "requirement"
            },
            "claim_ids": {
              "$ref": "#/$defs/v4IdSet"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "claim_ids",
            "replaceable"
          ],
          "properties": {
            "kind": {
              "const": "example"
            },
            "claim_ids": {
              "$ref": "#/$defs/v4IdSet"
            },
            "replaceable": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "input_claim_ids",
            "derivation",
            "evidence_level"
          ],
          "properties": {
            "kind": {
              "const": "derived"
            },
            "input_claim_ids": {
              "$ref": "#/$defs/v4IdSet"
            },
            "derivation": {
              "type": "object",
              "required": [
                "method_id",
                "method_version",
                "inputs_digest"
              ],
              "properties": {
                "method_id": {
                  "$ref": "#/$defs/v4Text"
                },
                "method_version": {
                  "$ref": "#/$defs/v4Text"
                },
                "inputs_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            },
            "evidence_level": {
              "const": "derived"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "assumption_id",
            "semantic_gap_ids",
            "reason",
            "requires_case_status"
          ],
          "properties": {
            "kind": {
              "const": "temporary_assumption"
            },
            "assumption_id": {
              "$ref": "#/$defs/v4Text"
            },
            "semantic_gap_ids": {
              "$ref": "#/$defs/v4IdSet"
            },
            "reason": {
              "$ref": "#/$defs/v4Text"
            },
            "requires_case_status": {
              "const": "Conditional"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "v4TestValue": {
      "type": "object",
      "required": [
        "value_id",
        "subject_ref",
        "field_path",
        "value",
        "used_by_refs",
        "value_origin"
      ],
      "properties": {
        "value_id": {
          "$ref": "#/$defs/v4Text"
        },
        "subject_ref": {
          "$ref": "#/$defs/v4Text"
        },
        "field_path": {
          "type": "string",
          "pattern": "^/(?:[^/~]|~0|~1)+(?:/(?:[^/~]|~0|~1)+)*$"
        },
        "value": {},
        "used_by_refs": {
          "$ref": "#/$defs/v4IdSet"
        },
        "value_origin": {
          "$ref": "#/$defs/v4TestValueOrigin"
        }
      },
      "additionalProperties": false
    },
    "v4ComparisonContract": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "exceptions"
          ],
          "properties": {
            "kind": {
              "const": "all_observable_behavior_except"
            },
            "exceptions": {
              "$ref": "#/$defs/v4StringSet"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "dimensions",
            "allowed_differences"
          ],
          "properties": {
            "kind": {
              "const": "selected_dimensions"
            },
            "dimensions": {
              "$ref": "#/$defs/v4IdSet"
            },
            "allowed_differences": {
              "$ref": "#/$defs/v4StringSet"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "v4BaselineSpec": {
      "type": "object",
      "required": [
        "baseline_id",
        "kind",
        "acquisition",
        "reference",
        "comparison_contract",
        "claim_ids"
      ],
      "properties": {
        "baseline_id": {
          "$ref": "#/$defs/v4Text"
        },
        "kind": {
          "const": "declared_reference"
        },
        "acquisition": {
          "const": "capture_at_execution"
        },
        "reference": {
          "$ref": "#/$defs/v4Text"
        },
        "comparison_contract": {
          "$ref": "#/$defs/v4ComparisonContract"
        },
        "claim_ids": {
          "$ref": "#/$defs/v4IdSet"
        }
      },
      "additionalProperties": false
    },
    "v4CanonicalCase": {
      "type": "object",
      "required": [
        "case_id",
        "title",
        "module_id",
        "priority",
        "ordering",
        "acceptance_role",
        "fact_ids",
        "semantic_status",
        "primary_test_point_id",
        "supporting_observation_ids",
        "business_preconditions",
        "data_conditions",
        "steps",
        "oracles"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/v4Text"
        },
        "title": {
          "$ref": "#/$defs/v4Text"
        },
        "module_id": {
          "$ref": "#/$defs/v4Text"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "ordering": {
          "type": "object",
          "required": [
            "business_flow_ref",
            "page_action_ref",
            "depends_on_case_ids"
          ],
          "properties": {
            "business_flow_ref": {
              "oneOf": [
                {
                  "$ref": "#/$defs/v4Text"
                },
                {
                  "type": "null"
                }
              ]
            },
            "page_action_ref": {
              "oneOf": [
                {
                  "$ref": "#/$defs/v4Text"
                },
                {
                  "type": "null"
                }
              ]
            },
            "depends_on_case_ids": {
              "$ref": "#/$defs/v4StringSet"
            }
          },
          "additionalProperties": false
        },
        "acceptance_role": {
          "enum": [
            "primary_acceptance",
            "dependency_contract",
            "context_only"
          ]
        },
        "fact_ids": {
          "$ref": "#/$defs/v4IdSet"
        },
        "semantic_status": {
          "enum": [
            "Grounded",
            "Conditional"
          ]
        },
        "primary_test_point_id": {
          "$ref": "#/$defs/v4Text"
        },
        "supporting_observation_ids": {
          "$ref": "#/$defs/v4StringSet"
        },
        "business_preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v4CasePrecondition"
          }
        },
        "data_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v4CaseCondition"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/v4CaseStep"
          }
        },
        "oracles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/v4CaseOracle"
          }
        },
        "semantic_effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/v4SemanticEffect"
          }
        },
        "baseline_spec": {
          "$ref": "#/$defs/v4BaselineSpec"
        },
        "test_values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/v4TestValue"
          }
        }
      },
      "additionalProperties": false
    },
    "v4ScopeModule": {
      "type": "object",
      "required": [
        "module_id",
        "name",
        "role",
        "claim_ids"
      ],
      "properties": {
        "module_id": {
          "$ref": "#/$defs/v4Text"
        },
        "name": {
          "$ref": "#/$defs/v4Text"
        },
        "role": {
          "enum": [
            "primary",
            "upstream",
            "downstream",
            "external"
          ]
        },
        "claim_ids": {
          "$ref": "#/$defs/v4IdSet"
        }
      },
      "additionalProperties": false
    },
    "v4ScopeBoundary": {
      "type": "object",
      "required": [
        "from",
        "to",
        "channel",
        "acceptance_scope",
        "claim_ids"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/v4Text"
        },
        "to": {
          "$ref": "#/$defs/v4Text"
        },
        "channel": {
          "$ref": "#/$defs/v4Text"
        },
        "acceptance_scope": {
          "const": "contract_only"
        },
        "claim_ids": {
          "$ref": "#/$defs/v4IdSet"
        }
      },
      "additionalProperties": false
    },
    "v4ScopeManifest": {
      "type": "object",
      "required": [
        "primary_surface",
        "modules",
        "boundaries"
      ],
      "properties": {
        "primary_surface": {
          "$ref": "#/$defs/v4Text"
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/v4ScopeModule"
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v4ScopeBoundary"
          }
        }
      },
      "additionalProperties": false
    },
    "v4CoverageLane": {
      "type": "object",
      "required": [
        "reviewed_formal_test_point_count",
        "covered_formal_test_point_count",
        "not_applicable_formal_test_point_count"
      ],
      "properties": {
        "reviewed_formal_test_point_count": {
          "type": "integer",
          "minimum": 0
        },
        "covered_formal_test_point_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable_formal_test_point_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "v4CoverageSummary": {
      "type": "object",
      "required": [
        "primary",
        "boundary",
        "semantic_gap_count",
        "exploratory_count",
        "not_applicable_count"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/v4CoverageLane"
        },
        "boundary": {
          "$ref": "#/$defs/v4CoverageLane"
        },
        "semantic_gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "exploratory_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "v4AffectedBusinessItem": {
      "type": "object",
      "required": [
        "item_kind",
        "item_id",
        "display_name"
      ],
      "properties": {
        "item_kind": {
          "enum": [
            "formal_test_point",
            "case",
            "business_outcome",
            "risk"
          ]
        },
        "item_id": {
          "$ref": "#/$defs/v4Text"
        },
        "display_name": {
          "$ref": "#/$defs/v4Text"
        }
      },
      "additionalProperties": false
    },
    "v4SemanticRootGroup": {
      "type": "object",
      "required": [
        "root_issue_id",
        "status",
        "title",
        "business_object",
        "question",
        "why_needed",
        "decision_impact",
        "unresolved_outcome",
        "affected_business_items"
      ],
      "properties": {
        "root_issue_id": {
          "$ref": "#/$defs/v4Text"
        },
        "status": {
          "enum": [
            "presented",
            "resolved",
            "resolved_final",
            "resolved_temporary",
            "deferred_by_user",
            "unknown_by_user",
            "closed_for_delivery",
            "obsolete"
          ]
        },
        "title": {
          "$ref": "#/$defs/v4Text"
        },
        "business_object": {
          "$ref": "#/$defs/v4Text"
        },
        "question": {
          "$ref": "#/$defs/v4Text"
        },
        "why_needed": {
          "$ref": "#/$defs/v4Text"
        },
        "decision_impact": {
          "$ref": "#/$defs/v4Text"
        },
        "unresolved_outcome": {
          "$ref": "#/$defs/v4Text"
        },
        "affected_business_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/v4AffectedBusinessItem"
          }
        },
        "root_version_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "acceptance_impact": {
          "$ref": "#/$defs/v4AcceptanceImpact"
        },
        "critical_resolution_basis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "root_issue_id",
                "root_version_digest",
                "basis_kind"
              ],
              "properties": {
                "root_issue_id": {
                  "$ref": "#/$defs/v4Text"
                },
                "root_version_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "basis_kind": {
                  "enum": [
                    "final_e3_decision",
                    "replayable_e2_derivation",
                    "evidence_not_applicable",
                    "evidence_obsolete"
                  ]
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "v4AcceptanceImpact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "criteria",
            "rationale"
          ],
          "properties": {
            "classification": {
              "const": "critical"
            },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "changes_core_acceptance",
                  "changes_required_branch",
                  "makes_required_result_undecidable"
                ]
              }
            },
            "rationale": {
              "$ref": "#/$defs/v4Text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "criteria",
            "rationale"
          ],
          "properties": {
            "classification": {
              "const": "noncritical"
            },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "const": "does_not_change_required_acceptance"
                }
              ],
              "items": false
            },
            "rationale": {
              "$ref": "#/$defs/v4Text"
            }
          }
        }
      ]
    },
    "v4ExploratoryPresentation": {
      "type": "object",
      "required": [
        "exploratory_id",
        "module_id",
        "title",
        "reason"
      ],
      "properties": {
        "exploratory_id": {
          "$ref": "#/$defs/v4Text"
        },
        "module_id": {
          "$ref": "#/$defs/v4Text"
        },
        "title": {
          "$ref": "#/$defs/v4Text"
        },
        "reason": {
          "$ref": "#/$defs/v4Text"
        }
      },
      "additionalProperties": false
    },
    "v4NotApplicablePresentation": {
      "type": "object",
      "required": [
        "not_applicable_record_id",
        "module_id",
        "subject",
        "reason"
      ],
      "properties": {
        "not_applicable_record_id": {
          "$ref": "#/$defs/v4Text"
        },
        "module_id": {
          "$ref": "#/$defs/v4Text"
        },
        "subject": {
          "$ref": "#/$defs/v4Text"
        },
        "reason": {
          "$ref": "#/$defs/v4Text"
        }
      },
      "additionalProperties": false
    },
    "v4EvidenceBasis": {
      "type": "object",
      "required": [
        "kind",
        "claim_ids"
      ],
      "properties": {
        "kind": {
          "const": "evidence"
        },
        "claim_ids": {
          "$ref": "#/$defs/v4IdSet"
        }
      },
      "additionalProperties": false
    },
    "v4SemanticGapBasis": {
      "type": "object",
      "required": [
        "kind",
        "subject_fact_ids",
        "missing_aspect"
      ],
      "properties": {
        "kind": {
          "const": "semantic_gap_analysis"
        },
        "subject_fact_ids": {
          "$ref": "#/$defs/v4IdSet"
        },
        "missing_aspect": {
          "$ref": "#/$defs/v4Text"
        }
      },
      "additionalProperties": false
    },
    "v4RiskCatalogBasis": {
      "type": "object",
      "required": [
        "kind",
        "policy_id",
        "policy_version"
      ],
      "properties": {
        "kind": {
          "const": "risk_catalog"
        },
        "policy_id": {
          "$ref": "#/$defs/v4Text"
        },
        "policy_version": {
          "$ref": "#/$defs/v4Text"
        }
      },
      "additionalProperties": false
    },
    "v4ScopeDecisionBasis": {
      "type": "object",
      "required": [
        "kind",
        "decision_ids"
      ],
      "properties": {
        "kind": {
          "const": "scope_decision"
        },
        "decision_ids": {
          "$ref": "#/$defs/v4IdSet"
        }
      },
      "additionalProperties": false
    },
    "v4RiskReviewItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module_id",
            "risk_kind",
            "acceptance_role",
            "status",
            "review_basis",
            "formal_test_point_ids"
          ],
          "properties": {
            "module_id": {
              "$ref": "#/$defs/v4Text"
            },
            "risk_kind": {
              "enum": [
                "null_or_missing",
                "unknown_enum",
                "api_failure",
                "loading_failure",
                "sync_delay",
                "long_content",
                "pagination",
                "refresh",
                "business_permission_boundary"
              ]
            },
            "acceptance_role": {
              "enum": [
                "primary_acceptance",
                "dependency_contract",
                "context_only"
              ]
            },
            "status": {
              "const": "formal"
            },
            "review_basis": {
              "$ref": "#/$defs/v4EvidenceBasis"
            },
            "formal_test_point_ids": {
              "$ref": "#/$defs/v4IdSet"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module_id",
            "risk_kind",
            "acceptance_role",
            "status",
            "review_basis",
            "semantic_gap_ids"
          ],
          "properties": {
            "module_id": {
              "$ref": "#/$defs/v4Text"
            },
            "risk_kind": {
              "enum": [
                "null_or_missing",
                "unknown_enum",
                "api_failure",
                "loading_failure",
                "sync_delay",
                "long_content",
                "pagination",
                "refresh",
                "business_permission_boundary"
              ]
            },
            "acceptance_role": {
              "enum": [
                "primary_acceptance",
                "dependency_contract",
                "context_only"
              ]
            },
            "status": {
              "const": "semantic_gap"
            },
            "review_basis": {
              "$ref": "#/$defs/v4SemanticGapBasis"
            },
            "semantic_gap_ids": {
              "$ref": "#/$defs/v4IdSet"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module_id",
            "risk_kind",
            "acceptance_role",
            "status",
            "review_basis",
            "exploratory_ids"
          ],
          "properties": {
            "module_id": {
              "$ref": "#/$defs/v4Text"
            },
            "risk_kind": {
              "enum": [
                "null_or_missing",
                "unknown_enum",
                "api_failure",
                "loading_failure",
                "sync_delay",
                "long_content",
                "pagination",
                "refresh",
                "business_permission_boundary"
              ]
            },
            "acceptance_role": {
              "enum": [
                "primary_acceptance",
                "dependency_contract",
                "context_only"
              ]
            },
            "status": {
              "const": "exploratory"
            },
            "review_basis": {
              "$ref": "#/$defs/v4RiskCatalogBasis"
            },
            "exploratory_ids": {
              "$ref": "#/$defs/v4IdSet"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module_id",
            "risk_kind",
            "acceptance_role",
            "status",
            "review_basis",
            "not_applicable_record_ids"
          ],
          "properties": {
            "module_id": {
              "$ref": "#/$defs/v4Text"
            },
            "risk_kind": {
              "enum": [
                "null_or_missing",
                "unknown_enum",
                "api_failure",
                "loading_failure",
                "sync_delay",
                "long_content",
                "pagination",
                "refresh",
                "business_permission_boundary"
              ]
            },
            "acceptance_role": {
              "enum": [
                "primary_acceptance",
                "dependency_contract",
                "context_only"
              ]
            },
            "status": {
              "const": "not_applicable"
            },
            "review_basis": {
              "oneOf": [
                {
                  "$ref": "#/$defs/v4EvidenceBasis"
                },
                {
                  "$ref": "#/$defs/v4ScopeDecisionBasis"
                }
              ]
            },
            "not_applicable_record_ids": {
              "$ref": "#/$defs/v4IdSet"
            }
          }
        }
      ]
    },
    "v4DispositionCounts": {
      "type": "object",
      "required": [
        "retained",
        "representative_value",
        "equivalent_merge",
        "evidence_exclusion",
        "semantic_gap",
        "exploratory"
      ],
      "properties": {
        "retained": {
          "type": "integer",
          "minimum": 0
        },
        "representative_value": {
          "type": "integer",
          "minimum": 0
        },
        "equivalent_merge": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_exclusion": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_gap": {
          "type": "integer",
          "minimum": 0
        },
        "exploratory": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "v4DesignAssuranceSummary": {
      "type": "object",
      "required": [
        "status",
        "plan_revision",
        "batch_count",
        "rule_group_count",
        "candidate_responsibility_count",
        "candidate_disposition_counts"
      ],
      "properties": {
        "status": {
          "const": "complete"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "batch_count": {
          "type": "integer",
          "minimum": 1
        },
        "rule_group_count": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_responsibility_count": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_disposition_counts": {
          "$ref": "#/$defs/v4DispositionCounts"
        }
      },
      "additionalProperties": false
    },
    "v4IndependentReviewSummary": {
      "type": "object",
      "required": [
        "status",
        "protocol_version",
        "review_mode",
        "reviewer_identity_class",
        "source_first_target_count",
        "target_assessment_counts",
        "finding_counts",
        "review_target_digest"
      ],
      "properties": {
        "status": {
          "const": "completed"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "review_mode": {
          "const": "independent_source_first"
        },
        "reviewer_identity_class": {
          "enum": [
            "independent_context",
            "independent_agent",
            "qualified_external_reviewer"
          ]
        },
        "source_first_target_count": {
          "type": "integer",
          "minimum": 1
        },
        "target_assessment_counts": {
          "type": "object",
          "required": [
            "verified",
            "semantic_gap",
            "evidence_excluded"
          ],
          "properties": {
            "verified": {
              "type": "integer",
              "minimum": 0
            },
            "semantic_gap": {
              "type": "integer",
              "minimum": 0
            },
            "evidence_excluded": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "finding_counts": {
          "type": "object",
          "required": [
            "confirmed",
            "rejected"
          ],
          "properties": {
            "confirmed": {
              "type": "integer",
              "minimum": 0
            },
            "rejected": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "review_target_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "caseDocumentBundle": {
      "type": "object",
      "required": [
        "schema_version",
        "compiler_version",
        "delivery_intent",
        "source_revision",
        "result_kind",
        "ordered_case_ids",
        "scope_manifest",
        "cases",
        "coverage",
        "semantic_root_groups",
        "exploratory",
        "not_applicable",
        "risk_review_ledger"
      ],
      "properties": {
        "schema_version": {
          "const": "4.3.3"
        },
        "compiler_version": {
          "const": "0.8.3"
        },
        "delivery_intent": {
          "const": "case_document"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 0
        },
        "result_kind": {
          "enum": [
            "delivered_cases",
            "delivered_with_gaps",
            "blocked_only",
            "no_applicable_cases"
          ]
        },
        "ordered_case_ids": {
          "$ref": "#/$defs/v4StringSet"
        },
        "scope_manifest": {
          "$ref": "#/$defs/v4ScopeManifest"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v4CanonicalCase"
          }
        },
        "coverage": {
          "$ref": "#/$defs/v4CoverageSummary"
        },
        "semantic_root_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v4SemanticRootGroup"
          }
        },
        "exploratory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v4ExploratoryPresentation"
          }
        },
        "not_applicable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v4NotApplicablePresentation"
          }
        },
        "risk_review_ledger": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v4RiskReviewItem"
          }
        },
        "design_assurance_summary": {
          "$ref": "#/$defs/v4DesignAssuranceSummary"
        },
        "independent_review_summary": {
          "$ref": "#/$defs/v4IndependentReviewSummary"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "design_assurance_summary",
                "independent_review_summary"
              ],
              "allOf": [
                {
                  "oneOf": [
                    {
                      "properties": {
                        "schema_version": {
                          "const": "4.3.3"
                        },
                        "compiler_version": {
                          "const": "0.8.3"
                        }
                      }
                    }
                  ]
                }
              ],
              "properties": {
                "schema_version": {
                  "const": "4.3.3"
                },
                "compiler_version": {
                  "const": "0.8.3"
                },
                "semantic_root_groups": {
                  "items": {
                    "required": [
                      "root_version_digest",
                      "acceptance_impact",
                      "critical_resolution_basis"
                    ],
                    "properties": {
                      "status": {
                        "not": {
                          "const": "resolved"
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/caseDocumentBundle"
    }
  ]
}

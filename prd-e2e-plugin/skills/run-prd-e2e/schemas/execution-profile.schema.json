{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-profile.schema.json",
  "type": "object",
  "required": ["schema_version", "environment", "execution_scope", "test_data", "evidence_policy", "business_cleanup", "pass_standard"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "environment": {
      "type": "object",
      "required": ["classification", "evidence"],
      "properties": {
        "classification": { "const": "non-production" },
        "evidence": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "additionalProperties": false
    },
    "execution_scope": {
      "type": "object",
      "required": ["case_ids"],
      "properties": {
        "case_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "test_data": { "$ref": "#/$defs/requirements" },
    "evidence_policy": { "$ref": "#/$defs/evidenceRequirements" },
    "business_cleanup": {
      "type": "object",
      "required": ["cases"],
      "properties": { "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cleanup" } } },
      "additionalProperties": false
    },
    "pass_standard": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "exact-expected-text" } },
      "additionalProperties": false
    }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "requirements": {
      "type": "object",
      "required": ["kind", "requirements"],
      "properties": { "kind": { "enum": ["case-document", "explicit"] }, "requirements": { "$ref": "#/$defs/strings" } },
      "additionalProperties": false
    },
    "evidenceRequirements": {
      "type": "object",
      "required": ["kind", "requirements"],
      "properties": { "kind": { "enum": ["runner-default", "explicit"] }, "requirements": { "$ref": "#/$defs/strings" } },
      "additionalProperties": false
    },
    "cleanup": {
      "oneOf": [
        {
          "type": "object",
          "required": ["case_id", "disposition", "instruction"],
          "properties": { "case_id": { "type": "string", "minLength": 1, "pattern": "\\S" }, "disposition": { "const": "required" }, "instruction": { "type": "string", "minLength": 1, "pattern": "\\S" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["case_id", "disposition", "reason"],
          "properties": { "case_id": { "type": "string", "minLength": 1, "pattern": "\\S" }, "disposition": { "const": "not_required" }, "reason": { "type": "string", "minLength": 1, "pattern": "\\S" } },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}

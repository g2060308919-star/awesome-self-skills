{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request.schema.json",
  "type": "object",
  "required": ["schema_version", "prd_sources", "target_urls"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "prd_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "target_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://" }
    },
    "suite_name": { "type": "string", "minLength": 1, "pattern": "\\S" }
  },
  "additionalProperties": false
}

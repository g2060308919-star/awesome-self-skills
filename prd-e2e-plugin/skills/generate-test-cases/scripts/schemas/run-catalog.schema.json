{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-catalog.schema.json",
  "type": "object",
  "required": ["catalog_version", "active_run_directory", "runs", "events"],
  "properties": {
    "catalog_version": {"const": 1},
    "active_run_directory": {"type": ["string", "null"]},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
    "events": {"type": "array", "items": {
      "type": "object",
      "required": ["sequence", "run_instance_id", "status", "reason"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "run_instance_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "completed", "failed", "superseded", "cancelled"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }}
  },
  "additionalProperties": false,
  "$defs": {
    "run": {
      "type": "object",
      "required": ["run_instance_id", "run_directory", "source_content_digest", "scope", "status", "last_reply_kind", "error_codes", "supersedes", "superseded_by"],
      "properties": {
        "run_instance_id": {"type": "string", "minLength": 1},
        "run_directory": {"type": "string", "pattern": "^/"},
        "source_content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scope": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "completed", "failed", "superseded", "cancelled"]},
        "last_reply_kind": {"enum": ["need_artifact", "need_revision", "need_user_answers", "finished", "fatal", "cancelled"]},
        "error_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "supersedes": {"type": ["string", "null"]},
        "superseded_by": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "checkpoint.schema.json", "type": "object",
  "required": ["input_digest", "source_revision", "stage", "compiler_version", "schema_version", "accepted_artifact_digests", "clarification_event_seq", "asked_root_issue_ids", "root_issue_dispositions", "last_question_set_digest", "clarification_stop"],
  "properties": { "input_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "source_revision": { "type": "integer", "minimum": 0 }, "stage": { "type": "string", "minLength": 1 }, "compiler_version": { "type": "string", "minLength": 1 }, "schema_version": { "const": "1.0.0" }, "accepted_artifact_digests": { "type": "object" }, "clarification_event_seq": { "type": "integer", "minimum": 0 }, "asked_root_issue_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "root_issue_dispositions": { "type": "object" }, "last_question_set_digest": { "type": "string" }, "clarification_stop": { "type": "object", "required": ["reason", "source_revision"], "properties": { "reason": { "enum": ["converged", "user_requested_delivery", "no_information_gain"] }, "source_revision": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } }, "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "test-bundle.schema.json", "type": "object",
  "required": ["schema_version", "source_revision", "grounded", "conditional", "blocked", "exploratory", "coverage", "quality"],
  "properties": { "schema_version": { "const": "1.0.0" }, "source_revision": { "type": "integer", "minimum": 0 }, "grounded": { "type": "array", "items": { "type": "object", "required": ["case_id", "title"], "properties": { "case_id": { "type": "string" }, "title": { "type": "string" } }, "additionalProperties": false } }, "conditional": { "type": "array", "items": { "type": "object", "required": ["case_id", "title"], "properties": { "case_id": { "type": "string" }, "title": { "type": "string" } }, "additionalProperties": false } }, "blocked": { "type": "array", "items": { "type": "object", "required": ["obligation_id", "reason"], "properties": { "obligation_id": { "type": "string" }, "reason": { "type": "string" } }, "additionalProperties": false } }, "exploratory": { "type": "array", "items": { "type": "object", "required": ["exploratory_id", "title"], "properties": { "exploratory_id": { "type": "string" }, "title": { "type": "string" } }, "additionalProperties": false } }, "coverage": { "type": "object", "required": ["requirements", "formal", "executable", "expert_recall"], "properties": { "requirements": { "type": "object", "required": ["total", "accounted"], "properties": { "total": { "type": "integer", "minimum": 0 }, "accounted": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "formal": { "type": "object", "required": ["total", "covered"], "properties": { "total": { "type": "integer", "minimum": 0 }, "covered": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "executable": { "type": "object", "required": ["total", "grounded"], "properties": { "total": { "type": "integer", "minimum": 0 }, "grounded": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "expert_recall": { "type": "object", "required": ["status"], "properties": { "status": { "const": "benchmark_only" } }, "additionalProperties": false } }, "additionalProperties": false }, "quality": { "type": "object", "required": ["delivery_status", "compiler_version", "schema_version"], "properties": { "delivery_status": { "enum": ["no_applicable_formal_test_points", "no_deterministic_cases", "critical_gaps", "executable_subset_ready"] }, "compiler_version": { "type": "string" }, "schema_version": { "const": "1.0.0" } }, "additionalProperties": false } }, "additionalProperties": false
}

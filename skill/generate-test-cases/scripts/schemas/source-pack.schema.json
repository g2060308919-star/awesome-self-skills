{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-pack.schema.json",
  "type": "object",
  "required": ["schema_version", "source_revision", "run_scope", "sources", "locators", "source_policy", "decision_records", "clarification_events"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source_revision": { "type": "integer", "minimum": 0 },
    "run_scope": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "items": { "type": "object", "required": ["source_id", "content", "content_digest"], "properties": { "source_id": { "type": "string", "minLength": 1 }, "kind": { "type": "string" }, "title": { "type": "string" }, "content": { "type": "string" }, "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "authority": { "type": "string" } }, "additionalProperties": false } },
    "locators": { "type": "array", "items": { "type": "object", "required": ["locator_id", "source_id", "type", "content_digest", "extraction_integrity"], "properties": { "locator_id": { "type": "string", "minLength": 1 }, "source_id": { "type": "string", "minLength": 1 }, "type": { "enum": ["text-range", "table-cell", "page-region"] }, "text_range": { "type": "object", "required": ["start", "end"], "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "table_cell": { "type": "object", "required": ["sheet", "cell"], "properties": { "sheet": { "type": "string", "minLength": 1 }, "cell": { "type": "string", "minLength": 1 } }, "additionalProperties": false }, "page_region": { "type": "object", "required": ["page", "region"], "properties": { "page": { "type": "integer", "minimum": 1 }, "region": { "type": "string", "minLength": 1 } }, "additionalProperties": false }, "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "extraction_integrity": { "enum": ["verified", "machine-extracted", "uncertain"] } }, "additionalProperties": false, "oneOf": [ { "required": ["text_range"], "properties": { "type": { "const": "text-range" } } }, { "required": ["table_cell"], "properties": { "type": { "const": "table-cell" } } }, { "required": ["page_region"], "properties": { "type": { "const": "page-region" } } } ] } },
    "source_policy": { "type": "object", "required": ["rules"], "properties": { "rules": { "type": "array", "items": { "type": "object" } } }, "additionalProperties": false },
    "decision_records": { "type": "array", "items": { "type": "object", "required": ["decision_id", "question_id", "root_issue_ids", "affected_obligation_ids", "clarification_event_seq", "confirmer", "confirmed_at", "question", "answer", "disposition", "authority_scope", "effective_scope"], "properties": { "decision_id": { "type": "string", "minLength": 1 }, "question_id": { "type": "string", "minLength": 1 }, "root_issue_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "affected_obligation_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "clarification_event_seq": { "type": "integer", "minimum": 1 }, "confirmer": { "type": "string", "minLength": 1 }, "confirmed_at": { "type": "string", "minLength": 1 }, "question": { "type": "string", "minLength": 1 }, "answer": { "type": "string" }, "disposition": { "enum": ["final", "temporary", "unknown", "deferred"] }, "authority_scope": { "type": "string" }, "effective_scope": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
    "clarification_events": { "type": "array", "items": { "type": "object", "required": ["event_id", "clarification_event_seq", "type", "actor", "event_at", "root_issue_ids"], "properties": { "event_id": { "type": "string", "minLength": 1 }, "clarification_event_seq": { "type": "integer", "minimum": 1 }, "type": { "enum": ["request_delivery", "reopen_root_issues"] }, "actor": { "type": "string", "minLength": 1 }, "event_at": { "type": "string", "minLength": 1 }, "root_issue_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } }, "additionalProperties": false } }
  },
  "additionalProperties": false
}

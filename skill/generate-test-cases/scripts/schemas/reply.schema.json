{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "reply.schema.json", "oneOf": [
    { "type": "object", "required": ["status", "stage", "schema_ref", "scope", "diagnostics"], "properties": { "status": { "const": "need_artifact" }, "stage": { "type": "string" }, "schema_ref": { "type": "string" }, "scope": { "type": "object" }, "diagnostics": { "type": "array" } }, "additionalProperties": false },
    { "type": "object", "required": ["status", "diagnostics"], "properties": { "status": { "const": "need_user_answers" }, "diagnostics": { "type": "array" }, "blockers": { "type": "array" } }, "additionalProperties": false },
    { "type": "object", "required": ["status", "stage", "diagnostics"], "properties": { "status": { "const": "need_revision" }, "stage": { "type": "string" }, "diagnostics": { "type": "array" } }, "additionalProperties": false },
    { "type": "object", "required": ["status", "source_revision", "bundle_path", "bundle_digest", "markdown_path"], "properties": { "status": { "const": "finished" }, "source_revision": { "type": "integer", "minimum": 0 }, "bundle_path": { "type": "string" }, "bundle_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "markdown_path": { "type": "string" } }, "additionalProperties": false },
    { "type": "object", "required": ["status", "diagnostics"], "properties": { "status": { "const": "fatal" }, "diagnostics": { "type": "array" } }, "additionalProperties": false }
  ]
}

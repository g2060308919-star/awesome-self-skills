{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "case-drafts.schema.json", "type": "object",
  "required": ["schema_version", "source_revision", "cases", "obligation_dispositions", "exploratory_candidates"],
  "properties": { "schema_version": { "const": "1.0.0" }, "source_revision": { "type": "integer", "minimum": 0 }, "cases": { "type": "array", "items": { "type": "object", "required": ["case_id", "title", "scope", "risk", "role", "steps"], "properties": { "case_id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "scope": { "type": "string" }, "risk": { "type": "string" }, "role": { "type": "string" }, "steps": { "type": "array", "minItems": 1 }, "obligation_ids": { "type": "array", "items": { "type": "string" } }, "source_claim_ids": { "type": "array", "items": { "type": "string" } }, "execution_signature": { "type": "object" } }, "additionalProperties": false } }, "obligation_dispositions": { "type": "array", "items": { "type": "object", "required": ["obligation_id", "status", "case_ids"], "properties": { "obligation_id": { "type": "string" }, "status": { "enum": ["case_candidate", "blocker", "not_applicable"] }, "case_ids": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } }, "exploratory_candidates": { "type": "array", "items": { "type": "object" } } }, "additionalProperties": false
}

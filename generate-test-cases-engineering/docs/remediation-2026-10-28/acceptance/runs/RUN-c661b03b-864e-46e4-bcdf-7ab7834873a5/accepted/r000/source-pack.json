:"SRC-local","type":"text_block_range","unit_id":"unit_8992dc8ce5b827c6"}],"output_language":"zh-CN","run_instance_id":"RUN-c661b03b-864e-46e4-bcdf-7ab7834873a5","run_scope":"configuration","schema_version":"4.3.3","source_assets":[],"source_policy":{"rules":[{"authority":"user supplied","rule_id":"POL-local","rule_internal_conflict_review":[],"scope":"configuration","source_ids":["SRC-local"],"status":"effective"}]},"source_reviews":[{"semantic_digest":"sha256:6d6cee85dfefbd0051569f3a21d5257f7e7f6cbd11aed9e216db767a4a3e3156","source_id":"SRC-local","units":[{"classification":"normative","content_digest":"sha256:f0978583647d00f575c519bd0662cc53124da7d6cacdcae8f617f8a085859a78","unit_id":"unit_95302172d992270f"},{"classification":"normative","content_digest":"sha256:62f86b2f2c5d547a258e6b5100c97d2528db3f69ddb117bcc0fcb4252edae522","unit_id":"unit_8992dc8ce5b827c6"},{"classification":"normative","content_digest":"sha256:d19dc59ec5144eadcef1022364de071fc873534f49364b49b9134367a628fd2c","unit_id":"unit_b037f7cce97c336f"},{"classification":"normative","content_digest":"sha256:d9a45630fa7083827db5f0dfb4b4eec5b7935698b24c6fbf9bf9eab0c26cfd0f","unit_id":"unit_86c3728ed279ad69"},{"classification":"normative","content_digest":"sha256:687e85d46656d31d67ab3953f87e2de006d19481d1a330badac1edd9efc7be58","unit_id":"unit_b09242fec7eaccba"},{"classification":"normative","content_digest":"sha256:2a91662b3eefadac3d2eccbe15be7fa3a5252f45cad927946b64bd4d45825d95","unit_id":"unit_331d3d4aaad939ad"},{"classification":"normative","content_digest":"sha256:a89890e88d04d139934410bea9314dea35acda9e0ad31dd62fa1a539495dcc32","unit_id":"unit_d672ae3680e6c457"}]}],"source_revision":0,"sources":[{"authority":"user supplied","capture_audit":{"capture_digest":"sha256:e8cac77947f2d04864fa758394060cac706e6418d07105dae5f71ac7ce277633","semantic_exclusions":[],"units":[{"capture_scalar_count":1047,"capture_unit_digest":"sha256:e8cac77947f2d04864fa758394060cac706e6418d07105dae5f71ac7ce277633","capture_unit_id":"capture_document","retained_spans":[{"end":1047,"semantic_end":1047,"semantic_start":0,"start":0}],"semantic_scalar_count":1047}]},"capture_digest":"sha256:e8cac77947f2d04864fa758394060cac706e6418d07105dae5f71ac7ce277633","content":"模块：配置工作台。角色为管理员、超级管理员、只读用户。所有角色可以筛选和查看；仅管理员、超级管理员可以新增、编辑、复制、下线、启用。\n\n可编辑字段为名称、开始时间、结束时间。三个字段均必填，名称为 1 至 10 个 ASCII 英文字母。新增时全部为空。时间精度为秒，统一使用 UTC 时间；用例使用明确的当前时刻测试数据，各动作以实际提交时刻判断时间条件。开始时间大于结束时间报错，相等合法。其他非法输入不提交；除下文明确文案外，不要求精确报错文字。\n\n保存草稿成功后状态为草稿，不受结束时间已过去影响。保存并生效要求结束时间严格晚于当前时间，否则不提交并提示“结束时间必须晚于当前时间”。成功后，开始时间晚于当前时间为待开始，否则为生效中。对已发布且未下线的记录，当前时间早于开始时间为待开始；当前时间大于或等于开始、但小于结束时间为生效中；当前时间大于或等于结束时间为已过期。开始与结束相等时，恰好到达该时刻按已过期处理。草稿和已下线记录不因时间变化自动发布。状态判定采用当前时刻，不约定自动刷新频率。\n\n待开始、生效中的记录允许下线；二次确认取消不改变记录，确认成功变为已下线。只有已下线记录允许启用：结束时间小于或等于当前时间时提示“无法启用”；结束时间晚于当前时间时二次确认，取消不改变记录，确认成功按开始时间确定待开始或生效中。其他状态不允许对应行操作。下线或启用请求失败时记录保持原状态，提示操作失败并允许重试；请求处理中，同一记录不接受重复行操作。\n\n所有状态的记录均允许查看、复制；仅草稿允许编辑，且这些操作仍受上述角色权限约束。查看显示全部可编辑字段及状态，均只读。复制先打开带全部可编辑值的新增弹窗，保存成功后才新建记录，原记录不变。编辑打开弹窗时全部可编辑字段清空，保存成功更新原记录，状态依保存按钮及时间规则确定。\n\n保存成功关闭弹窗。保存失败保留弹窗和全部输入，可重试；请求处理中重复点击只产生一次保存效果，不重复新建记录。取消关闭弹窗，再次打开按对应新增、复制或编辑入口的初始化规则处理，不恢复上次未保存内容。\n\n名称筛选为区分大小写的连续子串匹配。状态筛选精确匹配。生效时间筛选为闭区间相交匹配，端点接触算相交；筛选区间须起止齐全且起点不晚于终点，否则不发起搜索并提示“时间范围不合法”。未填写的筛选条件不限制结果；已填写的条件全部满足才匹配。首次搜索进入 loading，完成前不能再次发起搜索。重置后所有筛选字段为空，是否自动发起搜索不在本样本验收范围。\n","content_digest":"e8cac77947f2d04864fa758394060cac706e6418d07105dae5f71ac7ce277633","domain":"business","kind":"prd","scope":"configuration","semantic_digest":"sha256:6d6cee85dfefbd0051569f3a21d5257f7e7f6cbd11aed9e216db767a4a3e3156","semantic_projection":{"assets":[],"content":"模块：配置工作台。角色为管理员、超级管理员、只读用户。所有角色可以筛选和查看；仅管理员、超级管理员可以新增、编辑、复制、下线、启用。\n\n可编辑字段为名称、开始时间、结束时间。三个字段均必填，名称为 1 至 10 个 ASCII 英文字母。新增时全部为空。时间精度为秒，统一使用 UTC 时间；用例使用明确的当前时刻测试数据，各动作以实际提交时刻判断时间条件。开始时间大于结束时间报错，相等合法。其他非法输入不提交；除下文明确文案外，不要求精确报错文字。\n\n保存草稿成功后状态为草稿，不受结束时间已过去影响。保存并生效要求结束时间严格晚于当前时间，否则不提交并提示“结束时间必须晚于当前时间”。成功后，开始时间晚于当前时间为待开始，否则为生效中。对已发布且未下线的记录，当前时间早于开始时间为待开始；当前时间大于或等于开始、但小于结束时间为生效中；当前时间大于或等于结束时间为已过期。开始与结束相等时，恰好到达该时刻按已过期处理。草稿
{
  "idempotency_key": "fixture-c02-evidence-gap",
  "action": {
    "kind": "submit_artifact",
    "action_token": { "$fixture_binding": "required" },
    "artifact_kind": "evidence_claims",
    "artifact": {
      "semantic_review_seed_digest": { "$fixture_binding": "required" },
      "claims": [{ "claim_client_key": "claim-result", "primary_outcome_signature": { "$fixture_binding": "required" }, "observation_slot_digests": [{ "$fixture_binding": "required" }] }],
      "semantic_gaps": [{
        "semantic_gap_client_key": "gap-normal",

        "answer_contract": { "answer_mode": "typed_answer", "allowed_controls": ["answer", "defer", "unknown", "close_for_delivery"], "value_schema": { "kind": "text", "min_scalars": 1, "max_scalars": 128, "ambiguity_guard_set_id": "guard.normal" } },
        "question": "正常的唯一成功标准是什么？",

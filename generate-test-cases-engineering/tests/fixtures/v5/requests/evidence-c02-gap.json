      "decomposition_reviews": [{ "seed_digest": { "$fixture_binding": "required" }, "candidate_id": { "$fixture_binding": "required" }, "disposition": { "kind": "single_claim", "claim_client_key": "claim-result" } }],
      "ambiguity_reviews": [{ "seed_digest": { "$fixture_binding": "required" }, "candidate_id": { "$fixture_binding": "required" }, "disposition": { "kind": "semantic_gap", "semantic_gap_client_key": "gap-normal" } }],
      "entity_resolutions": []
    }
  }
}

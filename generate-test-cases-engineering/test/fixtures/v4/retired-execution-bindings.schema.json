{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retired-execution-bindings.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "caseDocumentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "revision", "manifest_digest", "bundle_digest"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "manifest_digest": { "$ref": "#/$defs/sha256" },
        "bundle_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "readinessEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "claim_ids"],
      "properties": {
        "domain": { "const": "testability" },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "disposition", "availability"],
          "properties": {
            "case_id": { "type": "string", "minLength": 1 },
            "disposition": { "enum": ["pending", "execute", "do_not_execute"] },
            "availability": { "enum": ["unknown", "unavailable"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "disposition", "availability", "readiness_evidence"],
          "properties": {
            "case_id": { "type": "string", "minLength": 1 },
            "disposition": { "enum": ["pending", "execute", "do_not_execute"] },
            "availability": { "enum": ["provided", "verified"] },
            "readiness_evidence": { "$ref": "#/$defs/readinessEvidence" }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "case_document_ref", "bindings"],
  "properties": {
    "schema_version": { "const": "4.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "case_document_ref": { "$ref": "#/$defs/caseDocumentRef" },
    "bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/binding" }
    }
  }
}

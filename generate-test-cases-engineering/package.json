{
  "name": "generate-test-cases-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node build/build.mjs",
    "build:v5-contracts": "node build/generate-v5-policy-artifacts.mjs",
    "check:v5-contracts": "node build/generate-v5-policy-artifacts.mjs --check",
    "test": "node --test --test-concurrency=1 test/v5/*.test.mjs test/interface/repository-published-sync.test.mjs",
    "test:benchmark": "node --test test/v5/case-output.test.mjs test/v5/fixture-runner.test.mjs",
    "check": "tsc --noEmit -p jsconfig.json && node build/build.mjs --check && npm test",
    "benchmark": "node test/fixtures-v5-runner.mjs tests/fixtures/v5/manifest.json",
    "public-pilot": "node test/fixtures-v5-runner.mjs tests/fixtures/v5/manifest.json"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkpoint.schema.json",
  "$defs": {
    "v4_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "v4_string_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "v4_question_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_part_id",
        "root_issue_id",
        "root_version_digest",
        "question",
        "why_needed",
        "decision_impact",
        "unresolved_outcome",
        "affected_facts",
        "answer_options",
        "risk_level",
        "available_actions",
        "action_context"
      ],
      "properties": {
        "question_part_id": {
          "type": "string",
          "pattern": "^QP-[0-9a-f]{64}$"
        },
        "root_issue_id": {
          "type": "string",
          "pattern": "^ROOT-[0-9a-f]{64}$"
        },
        "root_version_digest": {
          "$ref": "#/$defs/v4_sha256"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "why_needed": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "decision_impact": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "unresolved_outcome": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "affected_facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer_options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_level": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "available_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "answer_question_part",
              "defer_question_part",
              "mark_question_unknown",
              "request_delivery"
            ]
          }
        },
        "action_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presentation_id",
            "question_part_id",
            "root_issue_id",
            "root_version_digest"
          ],
          "properties": {
            "presentation_id": {
              "type": "string",
              "pattern": "^PRES-[0-9a-f]{64}$"
            },
            "question_part_id": {
              "type": "string",
              "pattern": "^QP-[0-9a-f]{64}$"
            },
            "root_issue_id": {
              "type": "string",
              "pattern": "^ROOT-[0-9a-f]{64}$"
            },
            "root_version_digest": {
              "$ref": "#/$defs/v4_sha256"
            }
          }
        }
      }
    },
    "v4_semantic_presentation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "presentation_id",
            "phase",
            "supersedes_presentation_id",
            "answered_part_ids",
            "remaining_part_ids",
            "cycle_digest",
            "run_actions",
            "recovery",
            "question_parts"
          ],
          "properties": {
            "schema_version": {
              "const": "4.3.3"
            },
            "presentation_id": {
              "type": "string",
              "pattern": "^PRES-[0-9a-f]{64}$"
            },
            "phase": {
              "enum": [
                "requirements_analysis",
                "case_design"
              ]
            },
            "supersedes_presentation_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^PRES-[0-9a-f]{64}$"
            },
            "answered_part_ids": {
              "$ref": "#/$defs/v4_string_set"
            },
            "remaining_part_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^QP-[0-9a-f]{64}$"
              }
            },
            "cycle_digest": {
              "$ref": "#/$defs/v4_sha256"
            },
            "run_actions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "const": "cancel_run"
                }
              ],
              "items": false
            },
            "recovery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "run_id",
                "committed_revision",
                "committed_checkpoint_digest",
                "after_partial_answer"
              ],
              "properties": {
                "mode": {
                  "const": "append_clarification_event"
                },
                "run_id": {
                  "type": "string",
                  "minLength": 1
                },
                "committed_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "committed_checkpoint_digest": {
                  "$ref": "#/$defs/v4_sha256"
                },
                "after_partial_answer": {
                  "const": "issue_successor_for_remaining_parts"
                }
              }
            },
            "question_parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/v4_question_part"
              }
            }
          },
          "allOf": [
            {
              "oneOf": [
                {
                  "properties": {
                    "schema_version": {
                      "const": "4.3.3"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "v4_semantic_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_gap_id",
        "root_issue_id",
        "root_version_digest",
        "question_part_id",
        "subject_fact_ids",
        "missing_aspect",
        "scope_ref",
        "code",
        "question",
        "why_needed",
        "decision_impact",
        "unresolved_outcome",
        "answer_options",
        "risk_level",
        "source_claim_ids",
        "affected_test_point_ids",
        "affected_facts",
        "discovery_phase"
      ],
      "properties": {
        "semantic_gap_id": {
          "type": "string",
          "pattern": "^SG-[0-9a-f]{64}$"
        },
        "root_issue_id": {
          "type": "string",
          "pattern": "^ROOT-[0-9a-f]{64}$"
        },
        "root_version_digest": {
          "$ref": "#/$defs/v4_sha256"
        },
        "question_part_id": {
          "type": "string",
          "pattern": "^QP-[0-9a-f]{64}$"
        },
        "subject_fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_aspect": {
          "type": "string",
          "minLength": 1
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "why_needed": {
          "type": "string",
          "minLength": 1
        },
        "decision_impact": {
          "type": "string",
          "minLength": 1
        },
        "unresolved_outcome": {
          "type": "string",
          "minLength": 1
        },
        "answer_options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_level": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "source_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "affected_test_point_ids": {
          "$ref": "#/$defs/v4_string_set"
        },
        "affected_facts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "discovery_phase": {
          "enum": [
            "pre_case",
            "post_case"
          ]
        },
        "acceptance_impact": {
          "$ref": "#/$defs/v4_acceptance_impact"
        }
      }
    },
    "v4_acceptance_impact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "criteria",
            "rationale"
          ],
          "properties": {
            "classification": {
              "const": "critical"
            },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "changes_core_acceptance",
                  "changes_required_branch",
                  "makes_required_result_undecidable"
                ]
              }
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "criteria",
            "rationale"
          ],
          "properties": {
            "classification": {
              "const": "noncritical"
            },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "const": "does_not_change_required_acceptance"
                }
              ],
              "items": false
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "v4_root_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_issue_id",
        "root_version_digest",
        "question_part_id",
        "status"
      ],
      "properties": {
        "root_issue_id": {
          "type": "string",
          "pattern": "^ROOT-[0-9a-f]{64}$"
        },
        "root_version_digest": {
          "$ref": "#/$defs/v4_sha256"
        },
        "question_part_id": {
          "type": "string",
          "pattern": "^QP-[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "presented",
            "resolved_final",
            "resolved_temporary",
            "deferred_by_user",
            "unknown_by_user",
            "closed_for_delivery",
            "obsolete"
          ]
        }
      }
    },
    "v4_decision_id_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^DEC-[0-9a-f]{64}$"
      }
    },
    "v4_decision_suspension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "newly_suspended_decision_ids",
        "cumulative_suspended_decision_ids",
        "reopen_event_id"
      ],
      "properties": {
        "newly_suspended_decision_ids": {
          "$ref": "#/$defs/v4_decision_id_set"
        },
        "cumulative_suspended_decision_ids": {
          "$ref": "#/$defs/v4_decision_id_set"
        },
        "reopen_event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "v4_reopened_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_issue_id",
        "prior_root_version_digest",
        "reopened_root_version_digest",
        "decision_suspension"
      ],
      "properties": {
        "root_issue_id": {
          "type": "string",
          "pattern": "^ROOT-[0-9a-f]{64}$"
        },
        "prior_root_version_digest": {
          "$ref": "#/$defs/v4_sha256"
        },
        "reopened_root_version_digest": {
          "$ref": "#/$defs/v4_sha256"
        },
        "decision_suspension": {
          "$ref": "#/$defs/v4_decision_suspension"
        }
      }
    },
    "v4_decision_suspension_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_issue_id",
        "cumulative_suspended_decision_ids"
      ],
      "properties": {
        "root_issue_id": {
          "type": "string",
          "pattern": "^ROOT-[0-9a-f]{64}$"
        },
        "cumulative_suspended_decision_ids": {
          "$ref": "#/$defs/v4_decision_id_set"
        }
      }
    },
    "v3_checkpoint": {
      "not": {}
    },
    "v4_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "compiler_version",
        "run_id",
        "revision",
        "commit_profile",
        "source_review_witness",
        "fact_ledger_digest",
        "scope_manifest_digest",
        "behavior_views_digest",
        "case_drafts_digest",
        "base_checkpoint_digest",
        "semantic_gap_ledger",
        "clarification_state"
      ],
      "properties": {
        "schema_version": {
          "const": "4.3.3"
        },
        "compiler_version": {
          "const": "0.8.3"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "commit_profile": {
          "enum": [
            "pre_case_pending",
            "post_case_pending",
            "final"
          ]
        },
        "source_review_witness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_unit_ids",
            "reviewed_unit_ids"
          ],
          "properties": {
            "expected_unit_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reviewed_unit_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "fact_ledger_digest": {
          "$ref": "#/$defs/v4_sha256"
        },
        "scope_manifest_digest": {
          "$ref": "#/$defs/v4_sha256"
        },
        "behavior_views_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/v4_sha256"
            }
          ]
        },
        "case_drafts_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/v4_sha256"
            }
          ]
        },
        "base_checkpoint_digest": {
          "$ref": "#/$defs/v4_sha256"
        },
        "reopened_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/v4_reopened_target"
          }
        },
        "decision_suspension_ledger": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/v4_decision_suspension_entry"
          }
        },
        "decision_reopen_overlay_digest": {
          "$ref": "#/$defs/v4_sha256"
        },
        "semantic_gap_ledger": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v4_semantic_gap"
          }
        },
        "clarification_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root_states",
            "answered_part_ids",
            "remaining_part_ids",
            "closed_for_delivery_part_ids",
            "cycle_digest",
            "latest_presentation_id",
            "presentation",
            "presentation_digest"
          ],
          "properties": {
            "root_states": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/v4_root_state"
              }
            },
            "answered_part_ids": {
              "$ref": "#/$defs/v4_string_set"
            },
            "remaining_part_ids": {
              "$ref": "#/$defs/v4_string_set"
            },
            "closed_for_delivery_part_ids": {
              "$ref": "#/$defs/v4_string_set"
            },
            "cycle_digest": {
              "$ref": "#/$defs/v4_sha256"
            },
            "latest_presentation_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^PRES-[0-9a-f]{64}$"
            },
            "presentation": {
              "$ref": "#/$defs/v4_semantic_presentation"
            },
            "presentation_digest": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/v4_sha256"
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "schema_version": {
                  "const": "4.3.3"
                },
                "compiler_version": {
                  "const": "0.8.3"
                },
                "semantic_gap_ledger": {
                  "items": {
                    "required": [
                      "acceptance_impact"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "not": {
            "type": "object",
            "required": [
              "commit_profile",
              "behavior_views_digest"
            ],
            "properties": {
              "commit_profile": {
                "const": "final"
              },
              "behavior_views_digest": {
                "type": "null"
              }
            }
          }
        },
        {
          "not": {
            "type": "object",
            "required": [
              "commit_profile",
              "case_drafts_digest"
            ],
            "properties": {
              "commit_profile": {
                "const": "final"
              },
              "case_drafts_digest": {
                "type": "null"
              }
            }
          }
        },
        {
          "not": {
            "type": "object",
            "required": [
              "commit_profile",
              "clarification_state"
            ],
            "properties": {
              "commit_profile": {
                "const": "final"
              },
              "clarification_state": {
                "type": "object",
                "required": [
                  "remaining_part_ids"
                ],
                "properties": {
                  "remaining_part_ids": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "not": {
            "type": "object",
            "required": [
              "commit_profile",
              "clarification_state"
            ],
            "properties": {
              "commit_profile": {
                "const": "final"
              },
              "clarification_state": {
                "type": "object",
                "required": [
                  "presentation"
                ],
                "properties": {
                  "presentation": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "not": {
            "type": "object",
            "required": [
              "commit_profile",
              "clarification_state"
            ],
            "properties": {
              "commit_profile": {
                "const": "final"
              },
              "clarification_state": {
                "type": "object",
                "required": [
                  "presentation_digest"
                ],
                "properties": {
                  "presentation_digest": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/v4_checkpoint"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "checkpoint.schema.json", "type": "object",
  "required": ["input_digest", "source_revision", "stage", "compiler_version", "schema_version", "accepted_artifact_digests", "clarification_event_seq", "asked_root_issue_ids", "root_issue_dispositions", "last_question_set_digest", "clarification_stop"],
  "properties": { "input_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "source_revision": { "type": "integer", "minimum": 0 }, "stage": { "enum": ["source_pack", "evidence_claims", "behavior_views", "test_obligations", "case_drafts", "verification", "final_bundle", "finished"] }, "compiler_version": { "type": "string", "minLength": 1 }, "schema_version": { "const": "1.0.0" }, "accepted_artifact_digests": { "type": "object", "properties": { "source_pack": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "evidence_claims": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "behavior_views": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "test_obligations": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "case_drafts": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "test_bundle": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false }, "clarification_event_seq": { "type": "integer", "minimum": 0 }, "asked_root_issue_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "root_issue_dispositions": { "type": "array", "items": { "type": "object", "required": ["root_issue_id", "status"], "properties": { "root_issue_id": { "type": "string", "minLength": 1 }, "status": { "enum": ["open", "asked", "resolved_final", "resolved_temporary", "suppressed_unknown", "suppressed_deferred"] } }, "additionalProperties": false } }, "last_question_set_digest": { "type": "string" }, "clarification_stop": { "type": "object", "required": ["reason", "source_revision"], "properties": { "reason": { "enum": ["converged", "user_requested_delivery", "no_information_gain"] }, "source_revision": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } }, "additionalProperties": false
}

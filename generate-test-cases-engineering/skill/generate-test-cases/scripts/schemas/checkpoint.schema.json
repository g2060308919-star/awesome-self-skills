{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkpoint.schema.json",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digest_map": {
      "type": "object",
      "properties": {
        "source_pack": { "$ref": "#/$defs/sha256" }, "evidence_claims": { "$ref": "#/$defs/sha256" },
        "behavior_views": { "$ref": "#/$defs/sha256" }, "test_obligations": { "$ref": "#/$defs/sha256" },
        "case_drafts": { "$ref": "#/$defs/sha256" }, "test_bundle": { "$ref": "#/$defs/sha256" }
      }, "additionalProperties": false
    },
    "clarification_stop": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["reason", "source_revision"], "properties": {
          "reason": { "enum": ["converged", "user_requested_delivery", "no_information_gain"] },
          "source_revision": { "type": "integer", "minimum": 0 }
        }, "additionalProperties": false }
      ]
    },
    "working_confirmation": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["confirmation_event_id", "confirmation_event_seq", "presented_source_revision", "presented_prompt_id", "confirmed_plan_digest", "confirmed_plan_change_head_seq", "actor", "confirmed_at", "authority_scope"],
          "properties": {
            "confirmation_event_id": { "type": "string", "minLength": 1 }, "confirmation_event_seq": { "type": "integer", "minimum": 1 },
            "presented_source_revision": { "type": "integer", "minimum": 0 }, "presented_prompt_id": { "type": "string", "minLength": 1 },
            "confirmed_plan_digest": { "$ref": "#/$defs/sha256" }, "confirmed_plan_change_head_seq": { "type": "integer", "minimum": 0 },
            "actor": { "type": "string", "minLength": 1 }, "confirmed_at": { "type": "string", "minLength": 1 }, "authority_scope": { "type": "string", "minLength": 1 }
          }, "additionalProperties": false }
      ]
    },
    "string_set": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "working_basis": { "oneOf": [
      { "type": "null" },
      { "type": "object", "required": ["origin"], "properties": { "origin": { "const": "default_grounded_recommendation" } }, "additionalProperties": false },
      { "type": "object", "required": ["origin", "exclusion_claim_id"], "properties": { "origin": { "const": "derived_not_applicable" }, "exclusion_claim_id": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
      { "type": "object", "required": ["origin", "execution_event_id"], "properties": { "origin": { "const": "user_execution_decision" }, "execution_event_id": { "type": "string", "minLength": 1 } }, "additionalProperties": false }
    ] },
    "working_item": {
      "type": "object", "required": ["item_kind", "item_id", "title", "semantic_status", "item_semantic_digest", "item_semantic_change_head_seq", "related_obligation_ids", "execution_disposition", "reason_code", "reason", "basis"],
      "properties": {
        "item_kind": { "enum": ["case", "formal_test_point", "exploratory"] }, "item_id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "semantic_status": { "enum": ["grounded", "conditional", "blocked", "not_applicable", "exploratory"] }, "item_semantic_digest": { "$ref": "#/$defs/sha256" },
        "item_semantic_change_head_seq": { "type": "integer", "minimum": 0 }, "related_obligation_ids": { "$ref": "#/$defs/string_set" },
        "execution_disposition": { "enum": ["pending", "execute", "do_not_execute"] }, "reason_code": { "type": ["string", "null"] }, "reason": { "type": ["string", "null"] }, "basis": { "$ref": "#/$defs/working_basis" }
      }, "additionalProperties": false
    },
    "promotion": { "type": "object", "required": ["exploratory_id", "adoption_decision_id", "obligation_ids", "case_ids"], "properties": {
      "exploratory_id": { "type": "string", "minLength": 1 }, "adoption_decision_id": { "type": "string", "minLength": 1 }, "obligation_ids": { "$ref": "#/$defs/string_set" }, "case_ids": { "$ref": "#/$defs/string_set" }
    }, "additionalProperties": false },
    "tp_coverage": { "type": "object", "required": ["obligation_id", "related_grounded_case_ids", "execute_case_ids", "status"], "properties": {
      "obligation_id": { "type": "string", "minLength": 1 }, "related_grounded_case_ids": { "$ref": "#/$defs/string_set" }, "execute_case_ids": { "$ref": "#/$defs/string_set" }, "status": { "enum": ["full", "partial", "none"] }
    }, "additionalProperties": false },
    "summary": { "type": "object", "required": ["case_count", "formal_test_point_count", "applicable_formal_test_point_count", "not_applicable_formal_test_point_count", "full_test_point_count", "partial_test_point_count", "none_test_point_count", "exploratory_count", "execute_case_count", "do_not_execute_case_count", "do_not_execute_formal_test_point_count", "do_not_execute_exploratory_count", "pending_case_count", "pending_formal_test_point_count", "pending_exploratory_count"], "properties": {
      "case_count": { "type": "integer", "minimum": 0 }, "formal_test_point_count": { "type": "integer", "minimum": 0 }, "applicable_formal_test_point_count": { "type": "integer", "minimum": 0 }, "not_applicable_formal_test_point_count": { "type": "integer", "minimum": 0 }, "full_test_point_count": { "type": "integer", "minimum": 0 }, "partial_test_point_count": { "type": "integer", "minimum": 0 }, "none_test_point_count": { "type": "integer", "minimum": 0 }, "exploratory_count": { "type": "integer", "minimum": 0 }, "execute_case_count": { "type": "integer", "minimum": 0 }, "do_not_execute_case_count": { "type": "integer", "minimum": 0 }, "do_not_execute_formal_test_point_count": { "type": "integer", "minimum": 0 }, "do_not_execute_exploratory_count": { "type": "integer", "minimum": 0 }, "pending_case_count": { "type": "integer", "minimum": 0 }, "pending_formal_test_point_count": { "type": "integer", "minimum": 0 }, "pending_exploratory_count": { "type": "integer", "minimum": 0 }
    }, "additionalProperties": false },
    "plan_snapshot": { "oneOf": [
      { "type": "null" },
      { "type": "object", "required": ["status", "resume_target", "run_identity_digest", "semantic_source_digest", "plan_digest", "plan_change_head_seq", "items", "runner_case_ids", "promoted_exploratory", "test_point_execution_coverage", "summary", "confirmation"], "properties": {
        "status": { "enum": ["decision_required", "paused", "awaiting_confirmation", "ready"] }, "resume_target": { "type": ["string", "null"], "enum": [null, "execution_closure", "final_confirmation"] },
        "run_identity_digest": { "$ref": "#/$defs/sha256" }, "semantic_source_digest": { "$ref": "#/$defs/sha256" }, "plan_digest": { "$ref": "#/$defs/sha256" }, "plan_change_head_seq": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/working_item" } }, "runner_case_ids": { "$ref": "#/$defs/string_set" }, "promoted_exploratory": { "type": "array", "items": { "$ref": "#/$defs/promotion" } },
        "test_point_execution_coverage": { "type": "array", "items": { "$ref": "#/$defs/tp_coverage" } }, "summary": { "$ref": "#/$defs/summary" }, "confirmation": { "$ref": "#/$defs/working_confirmation" }
      }, "additionalProperties": false }
    ] },
    "presentation_item": { "type": "object", "required": ["item_kind", "item_id", "title", "item_semantic_digest", "item_semantic_change_head_seq"], "properties": {
      "item_kind": { "enum": ["case", "formal_test_point", "exploratory"] }, "item_id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "item_semantic_digest": { "$ref": "#/$defs/sha256" }, "item_semantic_change_head_seq": { "type": "integer", "minimum": 0 }
    }, "additionalProperties": false },
    "presentation_option": { "type": "object", "required": ["option_code", "label", "meaning"], "properties": { "option_code": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "meaning": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "proposed_change": { "oneOf": [
      { "type": "null" },
      { "type": "object", "required": ["kind", "text"], "properties": { "kind": { "const": "supplement_business_rule" }, "text": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
      { "type": "object", "required": ["kind", "root_issue_ids"], "properties": { "kind": { "const": "reopen_root_issues" }, "root_issue_ids": { "$ref": "#/$defs/string_set" } }, "additionalProperties": false },
      { "type": "object", "required": ["kind", "source_locator_ids", "reason"], "properties": { "kind": { "const": "request_reanalysis" }, "source_locator_ids": { "$ref": "#/$defs/string_set" }, "reason": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
      { "type": "object", "required": ["kind", "disposition", "reason_code", "reason"], "properties": { "kind": { "const": "change_execution_disposition" }, "disposition": { "enum": ["execute", "do_not_execute"] }, "reason_code": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }, "additionalProperties": false }
    ] },
    "presentation_group": { "type": "object", "required": ["group_id", "question_id", "question", "item_refs", "allowed_options", "answer_example", "proposed_change"], "properties": {
      "group_id": { "type": "string", "minLength": 1 }, "question_id": { "type": "string", "minLength": 1 }, "question": { "type": "string", "minLength": 1 },
      "item_refs": { "type": "array", "items": { "$ref": "#/$defs/presentation_item" } }, "allowed_options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/presentation_option" } },
      "answer_example": { "type": "string", "minLength": 1 }, "proposed_change": { "$ref": "#/$defs/proposed_change" }
    }, "additionalProperties": false },
    "presentation": { "oneOf": [
      { "type": "null" },
      { "type": "object", "required": ["presentation_id", "purpose", "entry_context", "post_ready_control", "run_instance_id", "source_revision", "plan_digest", "plan_change_head_seq", "groups"], "properties": {
        "presentation_id": { "type": "string", "minLength": 1 }, "purpose": { "enum": ["semantic_clarification", "execution_closure", "final_confirmation"] }, "entry_context": { "enum": ["active_analysis", "post_ready_change"] },
        "post_ready_control": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["preview_epoch", "originating_request_instance_id"], "properties": { "preview_epoch": { "type": "integer", "minimum": 1 }, "originating_request_instance_id": { "type": "string", "minLength": 1 } }, "additionalProperties": false }] },
        "run_instance_id": { "type": "string", "minLength": 1 }, "source_revision": { "type": "integer", "minimum": 0 }, "plan_digest": { "$ref": "#/$defs/sha256" }, "plan_change_head_seq": { "type": "integer", "minimum": 0 }, "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/presentation_group" } }
      }, "additionalProperties": false }
    ] },
    "v4_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "v4_string_set": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "v4_question_part": {
      "type": "object", "additionalProperties": false,
      "required": ["question_part_id", "root_issue_id", "root_version_digest", "question", "why_needed", "decision_impact", "unresolved_outcome", "affected_facts", "answer_options", "risk_level", "available_actions", "action_context"],
      "properties": {
        "question_part_id": { "type": "string", "pattern": "^QP-[0-9a-f]{64}$" },
        "root_issue_id": { "type": "string", "pattern": "^ROOT-[0-9a-f]{64}$" },
        "root_version_digest": { "$ref": "#/$defs/v4_sha256" },
        "question": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "why_needed": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "decision_impact": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "unresolved_outcome": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "affected_facts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "answer_options": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "risk_level": { "enum": ["critical", "high", "medium", "low"] },
        "available_actions": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["answer_question_part", "defer_question_part", "mark_question_unknown", "request_delivery"] } },
        "action_context": {
          "type": "object", "additionalProperties": false,
          "required": ["presentation_id", "question_part_id", "root_issue_id", "root_version_digest"],
          "properties": {
            "presentation_id": { "type": "string", "pattern": "^PRES-[0-9a-f]{64}$" },
            "question_part_id": { "type": "string", "pattern": "^QP-[0-9a-f]{64}$" },
            "root_issue_id": { "type": "string", "pattern": "^ROOT-[0-9a-f]{64}$" },
            "root_version_digest": { "$ref": "#/$defs/v4_sha256" }
          }
        }
      }
    },
    "v4_semantic_presentation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "presentation_id", "phase", "supersedes_presentation_id", "answered_part_ids", "remaining_part_ids", "cycle_digest", "run_actions", "recovery", "question_parts"],
          "properties": {
            "schema_version": { "enum": ["4.0.0", "4.2.0", "4.3.0"] },
            "presentation_id": { "type": "string", "pattern": "^PRES-[0-9a-f]{64}$" },
            "phase": { "enum": ["requirements_analysis", "case_design"] },
            "supersedes_presentation_id": { "type": ["string", "null"], "pattern": "^PRES-[0-9a-f]{64}$" },
            "answered_part_ids": { "$ref": "#/$defs/v4_string_set" },
            "remaining_part_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^QP-[0-9a-f]{64}$" } },
            "cycle_digest": { "$ref": "#/$defs/v4_sha256" },
            "run_actions": { "type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{ "const": "cancel_run" }], "items": false },
            "recovery": {
              "type": "object", "additionalProperties": false,
              "required": ["mode", "run_id", "committed_revision", "committed_checkpoint_digest", "after_partial_answer"],
              "properties": {
                "mode": { "const": "append_clarification_event" }, "run_id": { "type": "string", "minLength": 1 },
                "committed_revision": { "type": "integer", "minimum": 0 }, "committed_checkpoint_digest": { "$ref": "#/$defs/v4_sha256" },
                "after_partial_answer": { "const": "issue_successor_for_remaining_parts" }
              }
            },
            "question_parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/v4_question_part" } }
          },
          "allOf": [{
            "oneOf": [
              {
                "properties": {
                  "schema_version": { "enum": ["4.0.0", "4.2.0"] },
                  "question_parts": { "items": { "properties": {
                    "available_actions": {
                      "type": "array", "minItems": 4, "maxItems": 4,
                      "prefixItems": [{ "const": "answer_question_part" }, { "const": "defer_question_part" }, { "const": "mark_question_unknown" }, { "const": "request_delivery" }],
                      "items": false
                    }
                  } } }
                }
              },
              { "properties": { "schema_version": { "const": "4.3.0" } } }
            ]
          }]
        }
      ]
    },
    "v4_semantic_gap": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_gap_id", "root_issue_id", "root_version_digest", "question_part_id", "subject_fact_ids", "missing_aspect", "scope_ref", "code", "question", "why_needed", "decision_impact", "unresolved_outcome", "answer_options", "risk_level", "source_claim_ids", "affected_test_point_ids", "affected_facts", "discovery_phase"],
      "properties": {
        "semantic_gap_id": { "type": "string", "pattern": "^SG-[0-9a-f]{64}$" },
        "root_issue_id": { "type": "string", "pattern": "^ROOT-[0-9a-f]{64}$" },
        "root_version_digest": { "$ref": "#/$defs/v4_sha256" },
        "question_part_id": { "type": "string", "pattern": "^QP-[0-9a-f]{64}$" },
        "subject_fact_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "missing_aspect": { "type": "string", "minLength": 1 }, "scope_ref": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 }, "question": { "type": "string", "minLength": 1 },
        "why_needed": { "type": "string", "minLength": 1 }, "decision_impact": { "type": "string", "minLength": 1 },
        "unresolved_outcome": { "type": "string", "minLength": 1 },
        "answer_options": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "risk_level": { "enum": ["critical", "high", "medium", "low"] },
        "source_claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "affected_test_point_ids": { "$ref": "#/$defs/v4_string_set" },
        "affected_facts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "discovery_phase": { "enum": ["pre_case", "post_case"] },
        "acceptance_impact": { "$ref": "#/$defs/v4_acceptance_impact" }
      }
    },
    "v4_acceptance_impact": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["classification", "criteria", "rationale"],
          "properties": {
            "classification": { "const": "critical" },
            "criteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["changes_core_acceptance", "changes_required_branch", "makes_required_result_undecidable"] } },
            "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["classification", "criteria", "rationale"],
          "properties": {
            "classification": { "const": "noncritical" },
            "criteria": { "type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{ "const": "does_not_change_required_acceptance" }], "items": false },
            "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        }
      ]
    },
    "v4_root_state": {
      "type": "object", "additionalProperties": false,
      "required": ["root_issue_id", "root_version_digest", "question_part_id", "status"],
      "properties": {
        "root_issue_id": { "type": "string", "pattern": "^ROOT-[0-9a-f]{64}$" },
        "root_version_digest": { "$ref": "#/$defs/v4_sha256" },
        "question_part_id": { "type": "string", "pattern": "^QP-[0-9a-f]{64}$" },
        "status": { "enum": ["presented", "resolved_final", "resolved_temporary", "deferred_by_user", "unknown_by_user", "closed_for_delivery", "obsolete"] }
      }
    },
    "v4_decision_id_set": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^DEC-[0-9a-f]{64}$" }
    },
    "v4_decision_suspension": {
      "type": "object", "additionalProperties": false,
      "required": ["newly_suspended_decision_ids", "cumulative_suspended_decision_ids", "reopen_event_id"],
      "properties": {
        "newly_suspended_decision_ids": { "$ref": "#/$defs/v4_decision_id_set" },
        "cumulative_suspended_decision_ids": { "$ref": "#/$defs/v4_decision_id_set" },
        "reopen_event_id": { "type": "string", "minLength": 1 }
      }
    },
    "v4_reopened_target": {
      "type": "object", "additionalProperties": false,
      "required": ["root_issue_id", "prior_root_version_digest", "reopened_root_version_digest", "decision_suspension"],
      "properties": {
        "root_issue_id": { "type": "string", "pattern": "^ROOT-[0-9a-f]{64}$" },
        "prior_root_version_digest": { "$ref": "#/$defs/v4_sha256" },
        "reopened_root_version_digest": { "$ref": "#/$defs/v4_sha256" },
        "decision_suspension": { "$ref": "#/$defs/v4_decision_suspension" }
      }
    },
    "v4_decision_suspension_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["root_issue_id", "cumulative_suspended_decision_ids"],
      "properties": {
        "root_issue_id": { "type": "string", "pattern": "^ROOT-[0-9a-f]{64}$" },
        "cumulative_suspended_decision_ids": { "$ref": "#/$defs/v4_decision_id_set" }
      }
    },
    "last_preview_request": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["request_instance_id", "request_digest", "result_epoch", "result_state", "result_kind", "cached_presentation"],
          "properties": {
            "request_instance_id": { "type": "string", "minLength": 1 }, "request_digest": { "$ref": "#/$defs/sha256" },
            "result_epoch": { "type": "integer", "minimum": 1 }, "result_state": { "enum": ["active", "closed", "consumed"] },
            "result_kind": { "enum": ["preview", "cancelled"] }, "cached_presentation": { "$ref": "#/$defs/presentation" }
          }, "additionalProperties": false }
      ]
    },
    "v3_checkpoint": {
      "type": "object",
      "required": ["input_digest", "source_revision", "stage", "compiler_version", "schema_version", "run_instance_id", "accepted_artifact_digests", "audit_lineage", "clarification_event_seq", "asked_root_issue_ids", "root_issue_dispositions", "last_question_set_digest", "clarification_stop", "workflow_event_head_seq", "workflow_event_log_digest", "execution_plan_snapshot", "presentation_snapshot", "presentation_snapshot_digest", "confirmation", "preview_epoch", "preview_state", "active_preview_presentation", "last_preview_request", "internal_result_kind"],
      "properties": {
        "input_digest": { "$ref": "#/$defs/sha256" }, "source_revision": { "type": "integer", "minimum": 0 },
        "stage": { "enum": ["source_pack", "evidence_claims", "behavior_views", "test_obligations", "case_drafts", "verification", "final_bundle", "finished"] },
        "compiler_version": { "type": "string", "minLength": 1 }, "schema_version": { "const": "3.0.0" },
        "run_instance_id": { "type": "string", "minLength": 1 }, "accepted_artifact_digests": { "$ref": "#/$defs/digest_map" },
        "audit_lineage": { "$ref": "#/$defs/digest_map" }, "clarification_event_seq": { "type": "integer", "minimum": 0 },
        "asked_root_issue_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "root_issue_dispositions": { "type": "array", "items": { "type": "object", "required": ["root_issue_id", "status"], "properties": { "root_issue_id": { "type": "string", "minLength": 1 }, "status": { "enum": ["open", "asked", "resolved_final", "resolved_temporary", "suppressed_unknown", "suppressed_deferred"] } }, "additionalProperties": false } },
        "last_question_set_digest": { "type": "string" }, "clarification_stop": { "$ref": "#/$defs/clarification_stop" },
        "workflow_event_head_seq": { "type": "integer", "minimum": 0 }, "workflow_event_log_digest": { "$ref": "#/$defs/sha256" },
        "execution_plan_snapshot": { "$ref": "#/$defs/plan_snapshot" }, "presentation_snapshot": { "$ref": "#/$defs/presentation" },
        "presentation_snapshot_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "confirmation": { "$ref": "#/$defs/working_confirmation" }, "preview_epoch": { "type": "integer", "minimum": 0 },
        "preview_state": { "enum": ["idle", "active", "closed", "consumed"] }, "active_preview_presentation": { "$ref": "#/$defs/presentation" },
        "last_preview_request": { "$ref": "#/$defs/last_preview_request" }, "internal_result_kind": { "type": ["string", "null"], "enum": [null, "analysis_only"] }
      },
      "additionalProperties": false
    },
    "v4_checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "compiler_version", "run_id", "revision", "commit_profile", "source_review_witness", "fact_ledger_digest", "scope_manifest_digest", "behavior_views_digest", "case_drafts_digest", "base_checkpoint_digest", "semantic_gap_ledger", "clarification_state"],
      "properties": {
        "schema_version": { "enum": ["4.0.0", "4.2.0", "4.3.0"] }, "compiler_version": { "enum": ["0.5.0", "0.7.0", "0.8.0"] },
        "run_id": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 0 },
        "commit_profile": { "enum": ["pre_case_pending", "post_case_pending", "final"] },
        "source_review_witness": {
          "type": "object", "additionalProperties": false,
          "required": ["expected_unit_ids", "reviewed_unit_ids"],
          "properties": {
            "expected_unit_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "reviewed_unit_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "fact_ledger_digest": { "$ref": "#/$defs/v4_sha256" }, "scope_manifest_digest": { "$ref": "#/$defs/v4_sha256" },
        "behavior_views_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/v4_sha256" }] },
        "case_drafts_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/v4_sha256" }] },
        "base_checkpoint_digest": { "$ref": "#/$defs/v4_sha256" },
        "reopened_targets": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/v4_reopened_target" }
        },
        "decision_suspension_ledger": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/v4_decision_suspension_entry" }
        },
        "decision_reopen_overlay_digest": { "$ref": "#/$defs/v4_sha256" },
        "semantic_gap_ledger": { "type": "array", "items": { "$ref": "#/$defs/v4_semantic_gap" } },
        "clarification_state": {
          "type": "object", "additionalProperties": false,
          "required": ["root_states", "answered_part_ids", "remaining_part_ids", "closed_for_delivery_part_ids", "cycle_digest", "latest_presentation_id", "presentation", "presentation_digest"],
          "properties": {
            "root_states": { "type": "array", "items": { "$ref": "#/$defs/v4_root_state" } },
            "answered_part_ids": { "$ref": "#/$defs/v4_string_set" }, "remaining_part_ids": { "$ref": "#/$defs/v4_string_set" },
            "closed_for_delivery_part_ids": { "$ref": "#/$defs/v4_string_set" }, "cycle_digest": { "$ref": "#/$defs/v4_sha256" },
            "latest_presentation_id": { "type": ["string", "null"], "pattern": "^PRES-[0-9a-f]{64}$" },
            "presentation": { "$ref": "#/$defs/v4_semantic_presentation" },
            "presentation_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/v4_sha256" }] }
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            { "properties": { "schema_version": { "const": "4.0.0" }, "compiler_version": { "const": "0.5.0" }, "semantic_gap_ledger": { "items": { "not": { "required": ["acceptance_impact"] } } } } },
            { "properties": { "schema_version": { "const": "4.2.0" }, "compiler_version": { "const": "0.7.0" }, "semantic_gap_ledger": { "items": { "not": { "required": ["acceptance_impact"] } } } } },
            { "properties": { "schema_version": { "const": "4.3.0" }, "compiler_version": { "const": "0.8.0" }, "semantic_gap_ledger": { "items": { "required": ["acceptance_impact"] } } } }
          ]
        },
        {
          "not": {
            "type": "object", "required": ["commit_profile", "behavior_views_digest"],
            "properties": { "commit_profile": { "const": "final" }, "behavior_views_digest": { "type": "null" } }
          }
        },
        {
          "not": {
            "type": "object", "required": ["commit_profile", "case_drafts_digest"],
            "properties": { "commit_profile": { "const": "final" }, "case_drafts_digest": { "type": "null" } }
          }
        },
        {
          "not": {
            "type": "object", "required": ["commit_profile", "clarification_state"],
            "properties": {
              "commit_profile": { "const": "final" },
              "clarification_state": {
                "type": "object", "required": ["remaining_part_ids"],
                "properties": { "remaining_part_ids": { "type": "array", "minItems": 1 } }
              }
            }
          }
        },
        {
          "not": {
            "type": "object", "required": ["commit_profile", "clarification_state"],
            "properties": {
              "commit_profile": { "const": "final" },
              "clarification_state": {
                "type": "object", "required": ["presentation"],
                "properties": { "presentation": { "not": { "type": "null" } } }
              }
            }
          }
        },
        {
          "not": {
            "type": "object", "required": ["commit_profile", "clarification_state"],
            "properties": {
              "commit_profile": { "const": "final" },
              "clarification_state": {
                "type": "object", "required": ["presentation_digest"],
                "properties": { "presentation_digest": { "not": { "type": "null" } } }
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/v3_checkpoint" },
    { "$ref": "#/$defs/v4_checkpoint" }
  ]
}

{
  "name": "generate-test-cases-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node build/build.mjs",
    "test": "node --test --test-concurrency=1 test/**/*.test.mjs && node --test test/repeatability/*.repeat.mjs",
    "check": "tsc --noEmit -p jsconfig.json && node build/build.mjs --check && npm test",
    "benchmark": "node benchmark/score.mjs benchmark/v1/manifest.json",
    "public-pilot": "node benchmark/public-pilot/validate.mjs benchmark/public-pilot/v1/catalog.json"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
